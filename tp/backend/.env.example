# KrishiClear Environment Configuration
# Google Gemini API Key for Kisan AI Multilingual Voice & Chat Advisory
GEMINI_API_KEY=your_gemini_api_key_here
GOOGLE_API_KEY=your_gemini_api_key_here

# LiveKit WebRTC Voice Infrastructure (Free Developer Tier from cloud.livekit.io)
LIVEKIT_URL=wss://krishiclear-xxxxxx.livekit.cloud
LIVEKIT_API_KEY=APIxxxxxxxxxxxxxx
LIVEKIT_API_SECRET=your_livekit_secret_here

# Groq Cloud Whisper API for Ultra-Fast Audio Transcription (Optional Free Tier)
GROQ_API_KEY=your_groq_api_key_here

# Optional: Custom Data.gov.in Agmarknet API Key (default built-in key provided in code)
# DATA_GOV_IN_API_KEY=your_datagov_key_here

# Optional: OpenAI API Key (if using OpenAI provider)
# OPENAI_API_KEY=your_openai_key_here

# Firebase Admin SDK Credentials (path to JSON file)
FIREBASE_CREDENTIALS=your_firebase_service_account.json

# Optional live payment gateway. Without these, the app records a demo payment.
# RAZORPAY_KEY_ID=rzp_test_xxxxxxxxxx
# RAZORPAY_KEY_SECRET=your_razorpay_secret
